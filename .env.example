# База данных
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Публичный адрес сайта (нужен для canonical, Open Graph и return_url оплаты)
NEXT_PUBLIC_SITE_URL=https://taktilno.ru

# Админ-панель (/admin). Обязательно задайте свои значения на проде!
ADMIN_PASSWORD=change-me
ADMIN_SECRET=random-long-string-for-cookie-signing

# Онлайн-оплата ЮKassa (src/lib/payments/index.ts)
# Webhook в ЛК ЮKassa: https://<домен>/api/payments/yookassa/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Уведомления о заказах в Telegram (src/lib/notifications/index.ts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
