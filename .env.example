# Скопируйте в .env (локально) или задайте в панели хостинга (RelaxDev → Настройки → Переменные окружения).

# PostgreSQL / Neon
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Публичный адрес сайта (для sitemap, og-тегов, ссылок в письмах)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Админ-панель
ADMIN_PASSWORD=taktilno
# любая длинная случайная строка (подпись cookie администратора)
ADMIN_SECRET=change-me-to-a-long-random-string

# Оплата ЮKassa (обязательно для оформления заказов; других способов оплаты нет)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Уведомления в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта России (см. DEPLOY.md, раздел «Почта России»)
# Индекс пункта отправления в Краснодаре (по умолчанию 350000).
POCHTA_FROM_INDEX=350000
# Объект тарификации: 23030 — «Посылка онлайн» (по умолчанию, публичный тариф
# без договора), 27030 — «Посылка стандарт», 47030 — «Посылка 1 класса».
# Если указанный объект недоступен, код сам перебирает запасные (23030, 27030).
POCHTA_TARIFF_OBJECT=23030
# Вес по умолчанию, г: одно изделие и упаковка посылки.
POCHTA_DEFAULT_ITEM_WEIGHT_G=150
POCHTA_PACKAGING_WEIGHT_G=150
# Выше этого веса (г) онлайн-тариф не считаем — берём стандартный.
POCHTA_MAX_WEIGHT_G=20000
# API «Отправка» по договору (необязательно; без них — публичный тариф).
# Токен и ключ: otpravka.pochta.ru → Настройки → API.
POCHTA_TOKEN=
POCHTA_KEY=
# Подсказка «Ваше отделение» по индексу (необязательно; без ключа карточка скрыта).
# Бесплатный API-ключ (10 тыс. запросов/день): dadata.ru → регистрация → API-ключ.
DADATA_API_KEY=

# СДЭК (API v2, https://api-docs.cdek.ru) — живой тариф по городу получателя.
# Ключи из ЛК СДЭК: Настройки → API: Account и Secure password.
# Без договора (CDEK_ACCOUNT/CDEK_SECRET) покупатели видят стандартный тариф 300 ₽.
CDEK_ACCOUNT=
CDEK_SECRET=
# Контур API: боевой — https://api.cdek.ru/v2 (по умолчанию),
# тестовый — https://api.edu.cdek.ru/v2.
CDEK_API_URL=https://api.cdek.ru/v2
# Откуда отправляем: город (и, если знаете, код населённого пункта СДЭК) и индекс.
CDEK_FROM_CITY=Краснодар
CDEK_FROM_CITY_CODE=
CDEK_FROM_POSTAL_CODE=350000
# Код тарифа: 136 — «Посылка склад-склад» (доставка в ПВЗ, по умолчанию),
# 234 — «Экономичная посылка склад-склад», 368 — «Посылка склад-постамат».
# Если тариф недоступен для направления, код сам перебирает запасные.
CDEK_TARIFF_CODE=136
# Вес одного изделия по умолчанию и упаковки, г; габариты посылки, см.
CDEK_DEFAULT_ITEM_WEIGHT_G=150
CDEK_PACKAGE_WEIGHT_G=150
CDEK_PACKAGE_LENGTH_CM=20
CDEK_PACKAGE_WIDTH_CM=15
CDEK_PACKAGE_HEIGHT_CM=12
# Выше этого веса (г) онлайн-тариф не считаем — берём стандартный.
CDEK_MAX_WEIGHT_G=30000
