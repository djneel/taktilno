# Скопируйте в .env (локально) или задайте в настройках хостинга (Vercel).

# PostgreSQL / Neon
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Публичный адрес сайта (для sitemap, og-тегов, ссылок в письмах)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Админ-панель
ADMIN_PASSWORD=taktilno
# любая длинная случайная строка (подпись cookie администратора)
ADMIN_SECRET=change-me-to-a-long-random-string

# Оплата ЮKassa (необязательно — пока пусто, заказы создаются со статусом «Ожидает оплаты»)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Уведомления в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
